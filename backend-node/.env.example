# SalesFire backend — server-side environment variables.
# Copy to .env and fill in real values. NEVER commit the real .env.
# Values below are placeholders only — do not use them in production.

# HTTP port for the Node.js API
PORT=8000

# development | test | production
ENVIRONMENT=development

# Auth — generate with: openssl rand -hex 48
JWT_SECRET=
JWT_REFRESH_SECRET=

# AES-256-GCM key for SMTP password encryption at rest — openssl rand -hex 32
# Rotating this makes previously stored SMTP passwords undecryptable.
ENCRYPTION_KEY=

# Database. MySQL 8 in production:
#   mysql://user:password@host:3306/salesfire
# SQLite is supported for local dev/test:
#   sqlite:./database.sqlite
DATABASE_URL=

# CORS origin of the React app
FRONTEND_URL=http://localhost:5173

# Public base URL used in campaign emails (unsubscribe links)
APP_BASE_URL=http://localhost:5173

# AI provider (OpenAI-compatible) key — backend-only. Never sent to the browser.
# Works with Groq (https://api.groq.com/openai/v1), Moonshot (https://api.moonshot.ai/v1), OpenAI, etc.
# When empty, AI generation endpoints return 501.
KIMI_API_KEY=your_api_key_here
KIMI_BASE_URL=https://api.groq.com/openai/v1
KIMI_MODEL=qwen/qwen3.8-27b

# Kimi endpoint (optional override)
# KIMI_BASE_URL=https://api.moonshot.cn/v1
# KIMI_MODEL=moonshot-v1-8k

# Global API rate limit (requests per 15-minute window per IP)
RATE_LIMIT_MAX=300
